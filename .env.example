# ── Supabase ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Python ML Service ─────────────────────────────
# Modal / Railway / Render-д deploy хийсэн URL
NEXT_PUBLIC_ML_SERVICE_URL=https://mongolz-ml.up.railway.app
ML_SERVICE_TOKEN=shared-secret-between-next-and-python

# ── Camera URL Encryption ─────────────────────────
# 32-byte key, base64-encoded. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set this to encrypt RTSP credentials at rest in DB.
# If unset, adding new camera URLs fails unless ALLOW_PLAINTEXT_CAMERA_URLS=1
# is explicitly set for throwaway local development.
CAMERA_URL_KEY=
ALLOW_PLAINTEXT_CAMERA_URLS=

# ── Camera URL key rotation (optional) ─────────────
# Previous CAMERA_URL_KEY during a rotation; decrypt falls back to it.
# Re-seal rows with: npm run encrypt:camera-urls -- --reencrypt, then unset.
CAMERA_URL_KEY_PREV=

# ── HMAC cookie / ticket secrets (REQUIRED in production) ──
# 32-byte URL-safe secrets. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   (or: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
# PRODUCTION FAILS CLOSED WITHOUT THESE (lib/auth/hmac-secret.ts): there is
# no fallback when VERCEL_ENV/NODE_ENV=production. Symptoms of a missing one:
#   REAUTH_COOKIE_SECRET  → TOTP users cannot sign in (/login shows the
#                           "server configuration error" message) and step-up
#                           (/api/auth/reauth[/totp]) returns 503 server_config
#   SESSION_PIN_SECRET    → session pin cookie cannot be minted/verified
#   STREAM_TICKET_SECRET  → HLS stream tickets cannot be issued
# Boot logs "[config] missing production secrets: …" (also a Sentry fatal);
# GET /api/health/auth (admin) and /health list the missing names.
# Local dev may fall back to SUPABASE_SERVICE_ROLE_KEY.
REAUTH_COOKIE_SECRET=
SESSION_PIN_SECRET=
STREAM_TICKET_SECRET=

# ── Cron / monitoring bearer tokens ───────────────
# Vercel injects CRON_SECRET into scheduled invocations (vercel.json crons).
CRON_SECRET=
MONITORING_CRON_SECRET=
SENTRY_ERROR_RATE_THRESHOLD=5
ANOMALY_THRESHOLD=3
SLACK_ALERT_WEBHOOK=

# ── Web push (VAPID) — generate with: npm run gen:vapid ─
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_DISPATCH_SECRET=

# ── Optional behaviour switches ───────────────────
# Kiosk hosts locked to /wall (comma-separated), e.g. live.example.com
WALL_HOSTS=
# WebAuthn origin override (defaults to https://<host>)
NEXT_PUBLIC_WEBAUTHN_ORIGIN=
# Feature flags (lib/flags.ts): MONGOLZ_FF_SESSION_PIN, MONGOLZ_FF_FACES_REAUTH,
# MONGOLZ_FF_ANOMALY_CRON, MONGOLZ_FF_PUSH_ALERTS, MONGOLZ_FF_WALL_SUBDOMAIN (1/0)

# ── Observability (D1, D4 — optional) ─────────────
# Sentry: create project at https://sentry.io and paste DSN
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# OpenTelemetry: OTLP HTTP collector endpoint (no trailing slash)
# Example: https://api.honeycomb.io  or  http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Claude API (зөвхөн Edge Function-д) ────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Telegram (BotFather-аас авна) ──────────────────
# 1. @BotFather → /newbot эсвэл /mybots → API Token
# 2. Bot руу мессеж бичээд: https://api.telegram.org/bot<TOKEN>/getUpdates
#    chat.id олно
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here
TELEGRAM_WEBHOOK_SECRET=shared-secret-for-edge-function-webhook
