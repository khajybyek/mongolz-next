{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/monitoring/error-rate",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/backup-verify",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/retention-sweep",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/key-rotation-check",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/anomaly-sweep",
      "schedule": "0 * * * *"
    }
  ]
}
