{
  "name": "mongolz-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "bash scripts/build-next.sh",
    "start": "next start",
    "lint": "eslint .",
    "lint:db": "supabase db lint --linked",
    "lint:migrations": "node scripts/lint-migrations.mjs",
    "heal:icloud": "bash scripts/heal-icloud.sh",
    "postinstall": "bash scripts/heal-icloud.sh",
    "rename:test-users": "tsx scripts/rename-test-users.ts",
    "typecheck": "find .next/types .next/dev/types -name '* 2.ts' -delete 2>/dev/null || true; next typegen && tsc --noEmit --incremental false",
    "create-user": "tsx scripts/create-admin.ts",
    "create-admin": "ROLE=admin tsx scripts/create-admin.ts",
    "create-viewer": "ROLE=viewer tsx scripts/create-admin.ts",
    "create-auditor": "ROLE=auditor tsx scripts/create-admin.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:wipe": "tsx scripts/demo-seed.ts --wipe",
    "deploy:prod": "vercel deploy --prod --yes",
    "deploy:staging": "vercel deploy --yes",
    "backup:verify": "tsx scripts/verify-backups.ts",
    "recovery:create": "tsx scripts/create-recovery-bundle.ts",
    "recovery:fixture": "tsx scripts/create-recovery-drill-fixture.ts",
    "recovery:restore": "tsx scripts/restore-recovery-bundle.ts",
    "evidence:decrypt": "tsx scripts/decrypt-evidence-package.ts",
    "rotate:keys": "tsx scripts/rotate-keys.ts",
    "gen:vapid": "tsx scripts/gen-vapid.ts",
    "test": "jest",
    "test:sql": "bash scripts/test-sql.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "encrypt:camera-urls": "tsx scripts/encrypt-camera-urls.ts",
    "gen:types": "supabase gen types typescript --linked --schema public > lib/database.generated.ts",
    "backup:restore": "tsx scripts/restore-from-backup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-fetch": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/nextjs": "^11.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.4",
    "esbuild": "^0.28.2",
    "hls.js": "^1.7.3",
    "jszip": "^3.10.2",
    "lucide-react": "^0.577.0",
    "next": "^16.3.6",
    "onnxruntime-web": "^1.30.0",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-turbopack": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.5.5",
    "web-push": "^3.6.7",
    "web-vitals": "^6.2.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.4",
    "jest": "^30.5.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1"
  }
}
