{
  "name": "mongolz-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:db": "supabase db lint --linked",
    "lint:migrations": "node scripts/lint-migrations.mjs",
    "heal:icloud": "bash scripts/heal-icloud.sh",
    "postinstall": "bash scripts/heal-icloud.sh",
    "rename:test-users": "tsx scripts/rename-test-users.ts",
    "typecheck": "find .next/types .next/dev/types -name '* 2.ts' -delete 2>/dev/null || true; next typegen && tsc --noEmit --incremental false",
    "create-user": "tsx scripts/create-admin.ts",
    "create-admin": "ROLE=admin tsx scripts/create-admin.ts",
    "create-viewer": "ROLE=viewer tsx scripts/create-admin.ts",
    "create-auditor": "ROLE=auditor tsx scripts/create-admin.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:wipe": "tsx scripts/demo-seed.ts --wipe",
    "deploy:prod": "vercel deploy --prod --yes",
    "deploy:staging": "vercel deploy --yes",
    "backup:verify": "tsx scripts/verify-backups.ts",
    "rotate:keys": "tsx scripts/rotate-keys.ts",
    "gen:vapid": "tsx scripts/gen-vapid.ts",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "encrypt:camera-urls": "tsx scripts/encrypt-camera-urls.ts",
    "gen:types": "supabase gen types typescript --linked --schema public > lib/database.generated.ts",
    "backup:restore": "tsx scripts/restore-from-backup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-fetch": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/nextjs": "^10.73.0",
    "@simplewebauthn/server": "^13.3.3",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "hls.js": "^1.7.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.4",
    "onnxruntime-web": "^1.26.0",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-turbopack": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.5.5",
    "web-push": "^3.6.7",
    "web-vitals": "^4.2.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.3.4",
    "@playwright/test": "^1.60.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "jest": "^30.4.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.2"
  }
}
