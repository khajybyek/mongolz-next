SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Next.js-аас ирэх authorization шалгах
ML_SERVICE_TOKEN=shared-secret-between-next-and-python

# Browser CORS зөвшөөрөх app origin-ууд (comma-separated)
ML_CORS_ORIGINS=http://localhost:3000,https://aicctv.dev

# HLS хадгалах folder (Railway/Modal-д /tmp нь хангалттай)
HLS_DIR=/tmp/mongolz-hls

PORT=8000

# AES-256-GCM master encryption key (32 байт base64).
# Original recording-уудыг at-rest шифрлэхэд хэрэглэнэ.
# Үүсгэх:  python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# WARNING: Энэ key байхгүй бол service start fail хийнэ.
# Зөвхөн local throwaway dev үед ALLOW_RANDOM_ENCRYPTION_KEY=1 ашиглаж болно.
ML_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# ── Added 2026-09-06 (variables the service reads that were undocumented) ──
# Blur strategy for NEW recordings: on_demand (default, ADR 0010) | baked (legacy rollback)
BLUR_STRATEGY=on_demand
# Previous master key during rotation (recordings + per-face chain keys fall back to it)
ML_ENCRYPTION_KEY_PREV=
# Tailscale userspace networking for home cameras (docker-entrypoint.sh)
TAILSCALE_AUTHKEY=
TS_HOSTNAME=mongolz-ml
CAMERA_TAILNET_FWD=5554:192.168.0.15:554
TAILSCALE_SOCKS_HOST=127.0.0.1
TAILSCALE_SOCKS_PORT=1055
# Dev-only switches — never set in production
ALLOW_API_DOCS=
ALLOW_NO_AUTH=
ALLOW_RANDOM_ENCRYPTION_KEY=
# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
# Paths
RECORDINGS_DIR=/tmp/mongolz-recordings
UPLOAD_DIR=/tmp/mongolz-upload
# Required on Railway: mount a persistent volume here so finalized recordings
# survive an ML process crash between local capture and Storage/DB commit.
RECORDING_SPOOL_DIR=/data/recording-spool
# CORS (comma-separated origins)
ML_CORS_ORIGINS=http://localhost:3000,https://aicctv.dev
