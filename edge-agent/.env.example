# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored.

# RTSP URL of the camera. Stays on the LAN — never leaves the agent host.
RTSP_URL=rtsp://{user}:{password}@10.0.0.42:554/stream1

# Cloud ML service the agent uploads frames-of-interest to.
ML_SERVICE_URL=https://mongolz-ml-production.up.railway.app
ML_SERVICE_TOKEN=replace-me

# Supabase camera UUID that this RTSP stream maps to.
CAMERA_ID=00000000-0000-0000-0000-000000000000

# Stable UUID for this physical edge device. Generate once and keep it.
AGENT_ID=00000000-0000-0000-0000-000000000000

# 32-byte AES-GCM key for the local encrypted outbox (base64).
# Generate: openssl rand -base64 32
EDGE_SPOOL_KEY=replace-with-base64-32-byte-key

# Persistent encrypted queue. The compose volume mounts this path.
EDGE_SPOOL_DIR=/var/lib/mongolz-edge
MAX_SPOOL_BYTES=2147483648
HEARTBEAT_INTERVAL_SEC=30
REQUEST_TIMEOUT_SEC=10

# Tuning — leave defaults unless the agent host is starved or you see drops.
SAMPLE_INTERVAL_SEC=1.0
MOTION_THRESHOLD=8.0
LOG_LEVEL=INFO
